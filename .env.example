# --- docker-compose stack -------------------------------------------------
HTTP_PORT=8080

POSTGRES_USER=bugbounty
POSTGRES_PASSWORD=bugbounty
POSTGRES_DB=bugbounty

# --- Attachment storage: AWS S3 -------------------------------------------
# IAM access keys with PutObject/GetObject on the bucket
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
# Leave empty for real AWS S3. Point at any S3-compatible service instead:
#   MinIO:  http://minio-host:9000
#   R2:     https://<account>.r2.cloudflarestorage.com
#   Spaces: https://<region>.digitaloceanspaces.com
S3_ENDPOINT=
# If the keys are left empty, attachment uploads/downloads are disabled
# (everything else keeps working).

# --- app secrets & settings ----------------------------------------------
# CHANGE THIS in production (any long random string)
SECRET=please_change_me_in_prod
# Comma-separated list of allowed browser origins (credentials are sent cross-origin)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
# Set true behind HTTPS
COOKIE_SECURE=false
# Set to your domain to scope auth cookies, e.g. .example.com
COOKIE_DOMAIN=

# First super_admin created by the seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234

# --- Telegram notifications (optional) ------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Public API -----------------------------------------------------------
# Trust X-Forwarded-For for client IPs (enable behind the bundled nginx; leave
# off when the API is directly reachable, so IPs can't be spoofed)
TRUST_PROXY_HEADERS=true
# Rate limits for unauthenticated endpoints, format <count>/<second|minute|hour|day>
RATE_LIMIT_REPORTS=10/hour
RATE_LIMIT_APPLICATIONS=3/hour
