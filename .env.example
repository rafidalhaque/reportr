# --- docker-compose stack -------------------------------------------------
HTTP_PORT=8080

POSTGRES_USER=bugbounty
POSTGRES_PASSWORD=bugbounty
POSTGRES_DB=bugbounty

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=attachments
# Where the browser can reach S3 for presigned attachment links (dev: exposed minio port)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- app secrets & settings ----------------------------------------------
# CHANGE THIS in production (any long random string)
SECRET=please_change_me_in_prod
# Comma-separated list of allowed browser origins (credentials are sent cross-origin)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
# Set true behind HTTPS
COOKIE_SECURE=false
# Set to your domain to scope auth cookies, e.g. .example.com
COOKIE_DOMAIN=

# First super_admin created by the seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234

# --- Telegram notifications (optional) ------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Public API -----------------------------------------------------------
# Trust X-Forwarded-For for client IPs (enable behind the bundled nginx; leave
# off when the API is directly reachable, so IPs can't be spoofed)
TRUST_PROXY_HEADERS=true
# Rate limits for unauthenticated endpoints, format <count>/<second|minute|hour|day>
RATE_LIMIT_REPORTS=10/hour
RATE_LIMIT_APPLICATIONS=3/hour
