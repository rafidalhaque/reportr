# Base URL the browser uses for API calls.
# Leave unset to use same-origin relative "/api" (recommended: your reverse proxy routes
# /api to the FastAPI backend in production, and `next dev` can proxy via
# API_PROXY_TARGET below).
#NEXT_PUBLIC_API_BASE=http://localhost:8000/api

# ---------------------------------------------------------------------
# Dev-only convenience (never needed in production):
# Set API_PROXY_TARGET when running `npm run dev` to proxy same-origin
# /api/* requests to the backend, avoiding CORS entirely:
#   API_PROXY_TARGET=http://localhost:8000 npm run dev
# It is only read by next.config.mjs during `next dev` and is not set
# anywhere in this repository.
#API_PROXY_TARGET=http://localhost:8000
